# From Supabase: Project Settings -> API
# Leave these as they are to use demo mode (saved in this browser only).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: notifications. The PUBLIC key from `npm run push:keys` (see README).
# Leave empty and the notification switch is hidden.
VITE_VAPID_PUBLIC_KEY=
